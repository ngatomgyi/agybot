# Telegram Bot Token from @BotFather (required)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Allowed Telegram User IDs (comma-separated, required)
ALLOWED_USERS=123456789

# Tmux session name for agybot (defaults to "agybot")
TMUX_SESSION_NAME=agybot

# Antigravity CLI command to run in new windows
# Default runs in accept-edits mode with yolo permissions auto-approval
AGY_COMMAND=agy --mode accept-edits --dangerously-skip-permissions

# Antigravity data directory (optional, auto-detected if empty)
# AGY_DATA_DIR=/root/.gemini/antigravity-cli

# Polling interval in seconds (optional, defaults to 1.5)
MONITOR_POLL_INTERVAL=1.5

# Display preferences in Telegram
AGYBOT_SHOW_TOOL_CALLS=true
AGYBOT_SHOW_THINKING=true
AGYBOT_SHOW_USER_MESSAGES=false
